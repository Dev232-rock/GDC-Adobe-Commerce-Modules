<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Repository Preference -->
    <preference for="Adobe\Employee\Api\EmployeeRepositoryInterface"
                type="Adobe\Employee\Model\EmployeeRepository"/>

    <!-- Interface Preference -->
    <preference for="Adobe\Employee\Api\Data\EmployeeInterface"
                type="Adobe\Employee\Model\Employee"/>

    <!-- UI Grid Collection -->
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">

                <item name="employee_employee_listing_data_source" xsi:type="string">
                    Adobe\Employee\Model\ResourceModel\Employee\Collection
                </item>

            </argument>
        </arguments>
    </type>

</config>